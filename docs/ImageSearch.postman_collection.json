{
  "info": {
    "name": "Kisna Image Search API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set baseUrl and adminToken (ADMIN_API_TOKEN from .env). /sync/* endpoints need the X-Admin-Token header."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        { "name": "Categories", "request": { "method": "GET", "url": "{{baseUrl}}/categories" } },
        { "name": "Product by ItemID", "request": { "method": "GET", "url": "{{baseUrl}}/products/1" } },
        { "name": "Product images", "request": { "method": "GET", "url": "{{baseUrl}}/products/1/images" } }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Search by reference image",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/search/image",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "top_k", "value": "10", "type": "text" },
                { "key": "mode", "value": "fusion", "type": "text", "description": "fusion | clip | dino (see MODES)" },
                { "key": "category", "value": "", "type": "text", "disabled": true },
                { "key": "plain_gold", "value": "all", "type": "text", "description": "all | yes | no", "disabled": true },
                { "key": "solitaire", "value": "all", "type": "text", "disabled": true },
                { "key": "valid", "value": "yes", "type": "text", "disabled": true },
                { "key": "franchise", "value": "all", "type": "text", "disabled": true },
                { "key": "item_codes", "value": "", "type": "text", "description": "comma-separated", "disabled": true },
                { "key": "min_score", "value": "", "type": "text", "disabled": true },
                { "key": "clip_weight", "value": "", "type": "text", "disabled": true },
                { "key": "dino_weight", "value": "", "type": "text", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Search (text and/or image, legacy)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/search-image",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "query", "value": "gold ring", "type": "text" },
                { "key": "file", "type": "file", "src": [], "disabled": true },
                { "key": "top_k", "value": "10", "type": "text" },
                { "key": "page", "value": "1", "type": "text" },
                { "key": "page_size", "value": "10", "type": "text" },
                { "key": "category", "value": "", "type": "text", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Index image (legacy)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/index-image",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "caption", "value": "", "type": "text" },
                { "key": "category", "value": "", "type": "text", "disabled": true },
                { "key": "metal", "value": "", "type": "text", "disabled": true },
                { "key": "item_id", "value": "", "type": "text", "disabled": true }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Sync (admin)",
      "item": [
        { "name": "Status", "request": { "method": "GET", "header": [{ "key": "X-Admin-Token", "value": "{{adminToken}}" }], "url": "{{baseUrl}}/sync/status" } },
        { "name": "History", "request": { "method": "GET", "header": [{ "key": "X-Admin-Token", "value": "{{adminToken}}" }], "url": { "raw": "{{baseUrl}}/sync/history?limit=50", "host": ["{{baseUrl}}"], "path": ["sync", "history"], "query": [{ "key": "limit", "value": "50" }] } } },
        { "name": "Failures", "request": { "method": "GET", "header": [{ "key": "X-Admin-Token", "value": "{{adminToken}}" }], "url": { "raw": "{{baseUrl}}/sync/failures?limit=200", "host": ["{{baseUrl}}"], "path": ["sync", "failures"], "query": [{ "key": "limit", "value": "200" }] } } },
        { "name": "Saved scope", "request": { "method": "GET", "header": [{ "key": "X-Admin-Token", "value": "{{adminToken}}" }], "url": "{{baseUrl}}/sync/scope" } },
        {
          "name": "Preview scope",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Admin-Token", "value": "{{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/sync/preview",
            "body": { "mode": "raw", "raw": "{\n  \"categories\": [],\n  \"plain_gold\": null,\n  \"solitaire\": null,\n  \"valid\": true,\n  \"franchise\": null,\n  \"search_text\": null,\n  \"max_products\": null\n}" }
          }
        },
        {
          "name": "Full sync (rebuild)",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Admin-Token", "value": "{{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/sync/full",
            "body": { "mode": "raw", "raw": "{\n  \"confirm\": true,\n  \"scope\": { \"valid\": true }\n}" }
          }
        },
        {
          "name": "Incremental sync (refresh saved scopes; also removes duplicate ItemCodes)",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Admin-Token", "value": "{{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/sync/incremental",
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Incremental sync (add a scope)",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Admin-Token", "value": "{{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/sync/incremental",
            "body": { "mode": "raw", "raw": "{\n  \"scope\": { \"categories\": [], \"valid\": true }\n}" }
          }
        },
        { "name": "Retry failed", "request": { "method": "POST", "header": [{ "key": "X-Admin-Token", "value": "{{adminToken}}" }], "url": "{{baseUrl}}/sync/retry-failed" } },
        { "name": "Cancel / stop job", "request": { "method": "POST", "header": [{ "key": "X-Admin-Token", "value": "{{adminToken}}" }], "url": "{{baseUrl}}/sync/cancel" } }
      ]
    }
  ]
}
