# Copy to .env (never commit .env). Placeholders only.
SQLSERVER_HOST=<sql-server-host>
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=<database-name>
SQLSERVER_USER=<read-only-user>
SQLSERVER_PASSWORD=<password>
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=false

IMAGE_BASE_URL=https://assets.kisna.com/
PRODUCT_COLLECTION=kisna-images-v1

# Required to call /sync/* endpoints (send as header X-Admin-Token)
ADMIN_API_TOKEN=<long-random-string>

SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_DAILY_AT=02:00

# Optional tuning
# Pilot: only sync products with ItemID <= this value (0 = everything)
SYNC_ITEM_ID_MAX=0
# Index only products with ItemValidSts = 'Y' (about 19% of products in the test DB)
SYNC_ONLY_VALID=false
SYNC_PRODUCT_BATCH=200
SYNC_EMBED_BATCH=16
SYNC_DOWNLOAD_CONCURRENCY=8
SYNC_DOWNLOAD_TIMEOUT_S=20
SYNC_DELETION_POLICY=mark_invalid
SEARCH_WEIGHT_CLIP=0.35
SEARCH_WEIGHT_DINO=0.65
